# ==========================================
#  MQL5-XAU-Analyzer — белый список
# ==========================================

# 1. Игнорируем ВСЁ в корне
/*

# 2. Разрешаем только нужные каталоги
!/.gitignore
!/README.md
!/Experts/
!/Include/
!/Files/

# 3. Experts — только наш Light
/Experts/*
!/Experts/AnalizLightGytHub/

# 4. Include — только наши модули (не стандартная библиотека MT5)
/Include/*
!/Include/Config.mqh
!/Include/DataStructures.mqh
!/Include/Analyzer.mqh
!/Include/SignalManager.mqh
!/Include/Storage.mqh
!/Include/Backtester.mqh
!/Include/Executor.mqh
!/Include/MovingAverages.mqh
!/Include/Object.mqh
!/Include/StdLibErr.mqh
!/Include/VirtualKeys.mqh
!/Include/Levels.mqh
!/Include/UI/
!/Include/GlobalVars.mqh
# 5. Files — только заглушка, данные генерируются советником
/Files/*
!/Files/.gitkeep

# 6. Мусор — даже внутри разрешённых папок
**/*.ex5
**/*.ex4
**/*.ex5.tmp
**/*.bak
**/*.tmp
**/*.log
**/*.set
**/*.opt
**/.DS_Store
**/Thumbs.db